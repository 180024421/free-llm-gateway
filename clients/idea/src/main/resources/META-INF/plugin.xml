<idea-plugin>
  <id>com.dashuai.gateway</id>
  <name>大帅网关</name>
  <vendor email="dashuai@local">Dashuai</vendor>
  <description><![CDATA[
    大帅网关 IDEA 插件：一键打开本机网关控制台，并提供 OpenAI 兼容接入说明。
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="Dashuai.OpenDashboard"
            class="com.dashuai.gateway.OpenDashboardAction"
            text="大帅网关: 打开控制台"
            description="Open Dashuai Gateway dashboard">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="Dashuai.ShowConnectHint"
            class="com.dashuai.gateway.ShowConnectHintAction"
            text="大帅网关: 显示接入说明"
            description="Show OpenAI-compatible endpoint hint">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.dashuai.gateway.DashuaiSettings"/>
    <applicationConfigurable
        parentId="tools"
        instance="com.dashuai.gateway.DashuaiConfigurable"
        id="com.dashuai.gateway.settings"
        displayName="大帅网关"/>
  </extensions>
</idea-plugin>
